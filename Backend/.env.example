# =============================================================
# Fisioterapeuta Li — Backend Environment Variables
# Copiar este archivo como .env y completar los valores
# =============================================================

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=cambiar-esto-por-una-clave-segura-aleatoria

# Base de datos PostgreSQL
DATABASE_URL=postgresql://fisio_user:fisio_pass@db:5432/fisio_db

# JWT
JWT_SECRET_KEY=cambiar-esto-por-otra-clave-segura
JWT_EXPIRATION_HOURS=24

# API Key para webhooks de n8n
N8N_API_KEY=cambiar-esto-por-una-api-key-segura

# CORS — Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Configuración de la fisioterapeuta
HORARIO_INICIO=08:00
HORARIO_FIN=18:00
HORARIO_SABADO_FIN=13:00
DIAS_LABORALES=0,1,2,3,4,5
BUFFER_ENTRE_SESIONES_MIN=15
ANTICIPACION_MINIMA_HORAS=2

# Admin por defecto (solo para seed inicial)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@fisioterapeuta-li.com
