# =========================================================
# Variables del módulo n8n-orchestration
# Copiar/fusionar estas líneas en el .env raíz del monorepo
# (no crear un .env separado por módulo — n8n las necesita
# disponibles en el mismo entorno donde corre docker compose)
# =========================================================

# --- Base de datos de n8n (persistencia interna, NO es la BD del negocio) ---
N8N_DB_USER=n8n
N8N_DB_PASSWORD=changeme
N8N_DB_NAME=n8n

# --- Acceso a n8n ---
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=genera-una-clave-larga-y-aleatoria
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# --- Telegram (coordinar con Daniel, dueño del módulo de Bot) ---
TELEGRAM_BOT_TOKEN=xxxxxxxxx:yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# --- Token compartido para autenticar llamadas entre TODOS los microservicios ---
# Debe ser el MISMO valor en el .env de cada compañero, o las llamadas fallarán con 401/403
INTERNAL_API_TOKEN=genera-un-secreto-compartido-con-el-equipo

# --- URLs internas de los servicios (hostnames = nombre del contenedor Docker) ---
AI_SERVICE_URL=http://ai-service:5000              # Camilo Peña — IA Local (Ollama)
CALENDAR_SERVICE_URL=http://calendar-service:5000  # Nicolas Muñoz — Google Calendar
GMAIL_SERVICE_URL=http://gmail-service:5000        # Samuel Suarez — Gmail
DRIVE_SHEETS_SERVICE_URL=http://drive-sheets-service:5000  # Taborda + Juan Neira — Drive + Sheets
AUTH_SERVICE_URL=http://auth-service:5000          # Samuel Suarez — Backend/BD/Auth/Panel Admin
