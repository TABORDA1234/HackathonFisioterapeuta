{
  "name": "Fisioterapeuta Li - Agendar sesión (referencia)",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"]
      },
      "id": "telegram_trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [200, 300],
      "webhookId": "telegram-trigger-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.AUTH_SERVICE_URL}}/auth/validate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Token", "value": "={{$env.INTERNAL_API_TOKEN}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chat_id", "value": "={{$json.message.chat.id}}" },
            { "name": "channel", "value": "telegram" }
          ]
        }
      },
      "id": "auth_validate",
      "name": "Validar usuario autorizado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{$json.data.authorized}}", "value2": true }
          ]
        }
      },
      "id": "if_authorized",
      "name": "¿Autorizado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.AI_SERVICE_URL}}/interpret",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Token", "value": "={{$env.INTERNAL_API_TOKEN}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "text", "value": "={{$('Telegram Trigger').item.json.message.text}}" },
            { "name": "chat_id", "value": "={{$('Telegram Trigger').item.json.message.chat.id}}" }
          ]
        }
      },
      "id": "ai_interpret",
      "name": "Interpretar intención (AI Service)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [860, 200]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{$json.data.intent}}", "value2": "agendar_sesion" }
          ]
        }
      },
      "id": "if_intent_agendar",
      "name": "¿Intención = agendar_sesion?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1080, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CALENDAR_SERVICE_URL}}/calendar/create",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Token", "value": "={{$env.INTERNAL_API_TOKEN}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "cliente", "value": "={{$json.data.entities.cliente}}" },
            { "name": "fecha", "value": "={{$json.data.entities.fecha}}" },
            { "name": "hora", "value": "={{$json.data.entities.hora}}" },
            { "name": "servicio", "value": "={{$json.data.entities.servicio}}" }
          ]
        }
      },
      "id": "calendar_create",
      "name": "Crear sesión (Calendar Service)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1300, 140]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{$json.data.ok}}", "value2": true }
          ]
        }
      },
      "id": "if_calendar_ok",
      "name": "¿Sesión creada?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1520, 140]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.GMAIL_SERVICE_URL}}/email/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Token", "value": "={{$env.INTERNAL_API_TOKEN}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "template", "value": "confirmacion_cita" },
            { "name": "vars", "value": "={{$json.data}}" }
          ]
        }
      },
      "id": "gmail_send",
      "name": "Enviar confirmación (Gmail Service)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1740, 80]
    },
    {
      "parameters": {
        "chatId": "={{$('Telegram Trigger').item.json.message.chat.id}}",
        "text": "✅ Sesión agendada correctamente. Se envió confirmación por correo."
      },
      "id": "telegram_confirm_ok",
      "name": "Responder OK",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1960, 80]
    },
    {
      "parameters": {
        "chatId": "={{$('Telegram Trigger').item.json.message.chat.id}}",
        "text": "⚠️ No se pudo agendar: {{$json.data.error.message}}"
      },
      "id": "telegram_confirm_fail",
      "name": "Responder error de negocio",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1740, 220]
    },
    {
      "parameters": {
        "chatId": "={{$('Telegram Trigger').item.json.message.chat.id}}",
        "text": "No entendí tu solicitud. ¿Puedes reformularla? (ej. 'Agenda a María el viernes a las 4pm')"
      },
      "id": "telegram_unknown_intent",
      "name": "Responder intención no reconocida",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "chatId": "={{$('Telegram Trigger').item.json.message.chat.id}}",
        "text": "No estás autorizado para usar este asistente."
      },
      "id": "telegram_not_authorized",
      "name": "Responder no autorizado",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [860, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.AUTH_SERVICE_URL}}/admin/log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Token", "value": "={{$env.INTERNAL_API_TOKEN}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "action", "value": "agendar_sesion" },
            { "name": "chat_id", "value": "={{$('Telegram Trigger').item.json.message.chat.id}}" },
            { "name": "result", "value": "={{$json.data}}" }
          ]
        }
      },
      "id": "audit_log",
      "name": "Registrar en auditoría",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1960, 220]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [[{ "node": "Validar usuario autorizado", "type": "main", "index": 0 }]]
    },
    "Validar usuario autorizado": {
      "main": [[{ "node": "¿Autorizado?", "type": "main", "index": 0 }]]
    },
    "¿Autorizado?": {
      "main": [
        [{ "node": "Interpretar intención (AI Service)", "type": "main", "index": 0 }],
        [{ "node": "Responder no autorizado", "type": "main", "index": 0 }]
      ]
    },
    "Interpretar intención (AI Service)": {
      "main": [[{ "node": "¿Intención = agendar_sesion?", "type": "main", "index": 0 }]]
    },
    "¿Intención = agendar_sesion?": {
      "main": [
        [{ "node": "Crear sesión (Calendar Service)", "type": "main", "index": 0 }],
        [{ "node": "Responder intención no reconocida", "type": "main", "index": 0 }]
      ]
    },
    "Crear sesión (Calendar Service)": {
      "main": [[{ "node": "¿Sesión creada?", "type": "main", "index": 0 }]]
    },
    "¿Sesión creada?": {
      "main": [
        [{ "node": "Enviar confirmación (Gmail Service)", "type": "main", "index": 0 }],
        [{ "node": "Responder error de negocio", "type": "main", "index": 0 }]
      ]
    },
    "Enviar confirmación (Gmail Service)": {
      "main": [[{ "node": "Responder OK", "type": "main", "index": 0 }]]
    },
    "Responder OK": {
      "main": [[{ "node": "Registrar en auditoría", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  }
}
