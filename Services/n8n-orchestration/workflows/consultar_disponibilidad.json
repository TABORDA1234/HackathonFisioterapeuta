{
  "name": "Fisioterapeuta Li - Consultar disponibilidad",
  "nodes": [
    {
      "parameters": { "updates": ["message"] },
      "id": "telegram_trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [200, 300],
      "webhookId": "telegram-trigger-disponibilidad"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.AUTH_SERVICE_URL}}/auth/validate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Internal-Token", "value": "={{$env.INTERNAL_API_TOKEN}}" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chat_id", "value": "={{$json.message.chat.id}}" },
            { "name": "channel", "value": "telegram" }
          ]
        }
      },
      "id": "auth_validate",
      "name": "Validar usuario autorizado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "conditions": { "boolean": [{ "value1": "={{$json.data.authorized}}", "value2": true }] }
      },
      "id": "if_authorized",
      "name": "¿Autorizado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.AI_SERVICE_URL}}/interpret",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Internal-Token", "value": "={{$env.INTERNAL_API_TOKEN}}" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "text", "value": "={{$('Telegram Trigger').item.json.message.text}}" },
            { "name": "chat_id", "value": "={{$('Telegram Trigger').item.json.message.chat.id}}" }
          ]
        }
      },
      "id": "ai_interpret",
      "name": "Interpretar intención (AI Service)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [860, 200]
    },
    {
      "parameters": {
        "conditions": { "string": [{ "value1": "={{$json.data.intent}}", "value2": "consultar_disponibilidad" }] }
      },
      "id": "if_intent_disponibilidad",
      "name": "¿Intención = consultar_disponibilidad?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1080, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.CALENDAR_SERVICE_URL}}/calendar/availability",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Internal-Token", "value": "={{$env.INTERNAL_API_TOKEN}}" }]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{ "name": "date", "value": "={{$json.data.entities.fecha}}" }]
        }
      },
      "id": "calendar_availability",
      "name": "Consultar disponibilidad (Calendar Service)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1300, 140]
    },
    {
      "parameters": {
        "jsCode": "const slots = $input.first().json.data.slots || [];\nconst texto = slots.length\n  ? '📅 Horarios disponibles:\\n' + slots.map(s => `• ${s}`).join('\\n')\n  : 'No hay horarios disponibles para esa fecha.';\nreturn [{ json: { texto } }];"
      },
      "id": "format_slots",
      "name": "Formatear respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1520, 140]
    },
    {
      "parameters": {
        "chatId": "={{$('Telegram Trigger').item.json.message.chat.id}}",
        "text": "={{$json.texto}}"
      },
      "id": "telegram_respond_slots",
      "name": "Responder disponibilidad",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1740, 140]
    },
    {
      "parameters": {
        "chatId": "={{$('Telegram Trigger').item.json.message.chat.id}}",
        "text": "No entendí tu consulta de disponibilidad. Prueba: '¿Tengo espacio el jueves en la tarde?'"
      },
      "id": "telegram_unknown_intent",
      "name": "Responder intención no reconocida",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "chatId": "={{$('Telegram Trigger').item.json.message.chat.id}}",
        "text": "No estás autorizado para usar este asistente."
      },
      "id": "telegram_not_authorized",
      "name": "Responder no autorizado",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [860, 420]
    }
  ],
  "connections": {
    "Telegram Trigger": { "main": [[{ "node": "Validar usuario autorizado", "type": "main", "index": 0 }]] },
    "Validar usuario autorizado": { "main": [[{ "node": "¿Autorizado?", "type": "main", "index": 0 }]] },
    "¿Autorizado?": {
      "main": [
        [{ "node": "Interpretar intención (AI Service)", "type": "main", "index": 0 }],
        [{ "node": "Responder no autorizado", "type": "main", "index": 0 }]
      ]
    },
    "Interpretar intención (AI Service)": { "main": [[{ "node": "¿Intención = consultar_disponibilidad?", "type": "main", "index": 0 }]] },
    "¿Intención = consultar_disponibilidad?": {
      "main": [
        [{ "node": "Consultar disponibilidad (Calendar Service)", "type": "main", "index": 0 }],
        [{ "node": "Responder intención no reconocida", "type": "main", "index": 0 }]
      ]
    },
    "Consultar disponibilidad (Calendar Service)": { "main": [[{ "node": "Formatear respuesta", "type": "main", "index": 0 }]] },
    "Formatear respuesta": { "main": [[{ "node": "Responder disponibilidad", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": {
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  }
}
