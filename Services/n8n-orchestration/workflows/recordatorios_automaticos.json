{
  "name": "Fisioterapeuta Li - Recordatorios automáticos",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 1 }]
        }
      },
      "id": "schedule_trigger",
      "name": "Cada hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.CALENDAR_SERVICE_URL}}/calendar/upcoming",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Internal-Token", "value": "={{$env.INTERNAL_API_TOKEN}}" }]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{ "name": "within_hours", "value": "24" }]
        }
      },
      "id": "get_upcoming",
      "name": "Obtener sesiones próximas (Calendar Service)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data.sessions",
        "options": {}
      },
      "id": "split_sessions",
      "name": "Separar por sesión",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.GMAIL_SERVICE_URL}}/email/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Internal-Token", "value": "={{$env.INTERNAL_API_TOKEN}}" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "to", "value": "={{$json.email}}" },
            { "name": "template", "value": "recordatorio_cita" },
            { "name": "vars", "value": "={{$json}}" }
          ]
        }
      },
      "id": "send_reminder_email",
      "name": "Enviar recordatorio (Gmail Service)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [860, 300]
    },
    {
      "parameters": {
        "conditions": { "boolean": [{ "value1": "={{$json.data.ok}}", "value2": true }] }
      },
      "id": "if_email_sent",
      "name": "¿Correo enviado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CALENDAR_SERVICE_URL}}/calendar/mark-reminded",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Internal-Token", "value": "={{$env.INTERNAL_API_TOKEN}}" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [{ "name": "id", "value": "={{$('Separar por sesión').item.json.id}}" }]
        }
      },
      "id": "mark_reminded",
      "name": "Marcar como recordado (Calendar Service)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1300, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.AUTH_SERVICE_URL}}/admin/log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Internal-Token", "value": "={{$env.INTERNAL_API_TOKEN}}" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "action", "value": "recordatorio_enviado" },
            { "name": "result", "value": "={{$('Separar por sesión').item.json}}" }
          ]
        }
      },
      "id": "audit_log",
      "name": "Registrar en auditoría",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1520, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.AUTH_SERVICE_URL}}/admin/log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Internal-Token", "value": "={{$env.INTERNAL_API_TOKEN}}" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "action", "value": "recordatorio_fallido" },
            { "name": "result", "value": "={{$('Separar por sesión').item.json}}" }
          ]
        }
      },
      "id": "audit_log_fail",
      "name": "Registrar fallo en auditoría",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1300, 400]
    }
  ],
  "connections": {
    "Cada hora": { "main": [[{ "node": "Obtener sesiones próximas (Calendar Service)", "type": "main", "index": 0 }]] },
    "Obtener sesiones próximas (Calendar Service)": { "main": [[{ "node": "Separar por sesión", "type": "main", "index": 0 }]] },
    "Separar por sesión": { "main": [[{ "node": "Enviar recordatorio (Gmail Service)", "type": "main", "index": 0 }]] },
    "Enviar recordatorio (Gmail Service)": { "main": [[{ "node": "¿Correo enviado?", "type": "main", "index": 0 }]] },
    "¿Correo enviado?": {
      "main": [
        [{ "node": "Marcar como recordado (Calendar Service)", "type": "main", "index": 0 }],
        [{ "node": "Registrar fallo en auditoría", "type": "main", "index": 0 }]
      ]
    },
    "Marcar como recordado (Calendar Service)": { "main": [[{ "node": "Registrar en auditoría", "type": "main", "index": 0 }]] }
  },
  "active": true,
  "settings": {
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  }
}
